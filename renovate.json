{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "automerge": true,
  "automergeType": "branch",
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day"
    }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alterius",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "a.8c7042.org",
      "custom_domain": true,
    },
  ],
  "vars": {
    "ALIAS_DOMAIN": "8c7042.org",
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alterius",
      "database_id": "098d1510-c330-4138-a8c0-0dd69944d5d4",
      "migrations_dir": "worker/migrations",
    },
  ],
}
